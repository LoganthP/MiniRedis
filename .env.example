# DEMO profile: disposable instance with sample data and the chaos lab.
# Never point this at data you care about.
INSTANCE_NAME=local-demo
DASHBOARD_PASSWORD=__GENERATE__
SESSION_SECRET=__GENERATE__
DB_PASSWORD=
PUBLIC_READS=true           # visitors can browse the sample keys; writes still need the password
ALLOW_DEMO_WORKLOAD=true   # simulated e-commerce traffic (writes shop:* keys)
ALLOW_CRASH_DEMO=true
APPENDFSYNC=always
SNAPSHOT_EVERY_OPS=10000
SNAPSHOT_EVERY_SECONDS=300
WEB_PORT=8081
WEB_BIND=0.0.0.0
DOMAIN=
