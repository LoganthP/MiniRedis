# PRIVATE deployment profile: real data, everything behind sign-in.
INSTANCE_NAME=miniredis
DASHBOARD_PASSWORD=__GENERATE__
SESSION_SECRET=__GENERATE__
DB_PASSWORD=__GENERATE__
PUBLIC_READS=false          # key names/values/console/log require sign-in
ALLOW_DEMO_WORKLOAD=false   # simulated e-commerce traffic (writes shop:* keys)
ALLOW_CRASH_DEMO=false      # no DEBUG CRASH on real data
APPENDFSYNC=always
SNAPSHOT_EVERY_OPS=10000
SNAPSHOT_EVERY_SECONDS=300
WEB_PORT=8081
WEB_BIND=127.0.0.1          # only reachable through the HTTPS proxy / SSH tunnel; set 0.0.0.0 to expose directly
DOMAIN=                     # e.g. miniredis.example.com, then: docker compose --profile https up -d
